{
  "expo": {
    "name": "Clipeo Scoreboard",
    "slug": "clipeo-scoreboard",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clipeostats.scoreboard",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "es",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E1E1E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clipeostats.scoreboard",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Clipeo Scoreboard",
      "output": "single",
      "themeColor": "#070A12",
      "backgroundColor": "#070A12"
    },
    "backgroundColor": "#070A12",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#E1E1E1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111919"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ]
    ],
    "description": "Marcador de voleibol minimalista: números a pantalla completa, gestos configurables y modos de puntuación.",
    "extra": {
      "eas": {
        "projectId": "761fc5cf-e0ae-4631-a57c-91209955ee65"
      }
    },
    "owner": "pauhdr"
  }
}
